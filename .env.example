VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica
# Feature flag do funil de status (F1). Default: desligada.
# Gateia somente a UI. Depois do migrate, RPC/triggers existem no servidor mesmo com a flag OFF.
# Valores que ligam: 1, true, on, yes
VITE_FF_GLC_FUNIL_STATUS=
# Feature flag da fila de cadência (F2). Default: desligada.
# Gateia somente a UI (menu Hoje, fila, ações e timeline). Depois do migrate, RPC/triggers existem no servidor mesmo com a flag OFF.
# Ramp da F2 assume F1 ligada (VITE_FF_GLC_FUNIL_STATUS). Com F2 OFF o legado não quebra.
# Valores que ligam: 1, true, on, yes
VITE_FF_GLC_FILA_CADENCIA=
# Feature flag do Kit WhatsApp (F3). Default: desligada.
# Gateia somente a UI (botão/modal Abrir WhatsApp com template e config). Depois do migrate, colunas e wa_templates existem no servidor mesmo com a flag OFF.
# O envio continua só via https://wa.me/... — sem WhatsApp Business API / BSP / envio server-side.
# Ramp da F3 assume migrate F2 (motor Toquei). Com F3 OFF o fallback da F2 (wa.me sem template) permanece.
# Valores que ligam: 1, true, on, yes
VITE_FF_GLC_KIT_WHATSAPP=
# Feature flag de porteiro vs decisor (F4). Default: desligada.
# Gateia somente a UI (blocos de contato, radio do WhatsApp padrão, seletor F3 e spotlight).
# Depois do migrate, as colunas existem no servidor mesmo com a flag OFF.
# Ramp da F4 assume migrate F3 (seletor no modal wa.me). Sem Opção B (lead_contato).
# Valores que ligam: 1, true, on, yes
VITE_FF_GLC_PORTEIRO_DECISOR=
# Feature flag do Guia de conversa (F11). Default: desligada.
# Gateia somente a UI (rename do chrome, tab WhatsApp, rota /guia-conversa).
# Flag OFF: chrome legado “Guia de ligação”, sem tab WhatsApp nova.
# Sem migrate. Conteúdo do Guia é estático no frontend. Não atualiza os 5 wa_templates.
# Valores que ligam: 1, true, on, yes
VITE_FF_GLC_GUIA_CONVERSA=
# Feature flag de reunião com 1 clique (F5). Default: desligada.
# Gateia somente a UI (modal completo, card countdown, CTAs Hoje de confirmar/resultado).
# Depois do migrate, colunas/RPC/D-1 existem no servidor mesmo com a flag OFF.
# Flag OFF: stub F1 (data/hora + link) permanece se F1 ON. Sem Google Calendar / Zoom OAuth.
# Valores que ligam: 1, true, on, yes
VITE_FF_GLC_REUNIAO=
# Feature flag do mini-kanban do funil (F6). Default: desligada.
# Gateia somente a UI (abas Tabela | Kanban e o board). Sem migration.
# Ramp da F6 assume F1 ligada (VITE_FF_GLC_FUNIL_STATUS). DnD reusa RPCs/modais F1/F5.
# Com F6 OFF a aba Leads permanece só tabela. Sem WIP, swimlanes, convertidos no board ou CMS.
# Valores que ligam: 1, true, on, yes
VITE_FF_GLC_MINI_KANBAN=
